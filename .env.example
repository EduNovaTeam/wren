# 复制为 .env 后按需修改。`node scripts/dev.mjs` 会自动读取本文件。
# 模型的 base_url / api key / 模型名不在这里配置，启动后在「设置 → 模型」里填写（保存在 data/wren.db）。

# 后端与 agent 之间内部接口的共享口令。用 dev.mjs 启动时留空会自动生成。
WREN_INTERNAL_TOKEN=

# 端口
WREN_BACKEND_PORT=5280
WREN_AGENT_PORT=5281

# 数据目录（SQLite 等），默认是仓库根目录下的 data/
# WREN_DATA_DIR=./data

# 用户 Skill 目录。默认是 <数据目录>/skills；同名的用户版本覆盖仓库内置的 skills/
# WREN_SKILLS_DIR=./data/skills

# Skill 的上下文预算（估算 token），独立于历史预算。
# 正文超限的 Skill 会显示为不可用并拒绝激活，不做静默截断。
# WREN_SKILL_BODY_BUDGET=24000
# WREN_SKILL_INDEX_BUDGET=1500
# WREN_SKILL_ACTIVE_BUDGET=40000
